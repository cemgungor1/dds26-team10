# Plain Redis mode (no Sentinel): uncomment REDIS_HOST and comment REDIS_SENTINELS
REDIS_HOST=redis-master-stock
REDIS_PORT=6379

# Sentinel mode (HA): set REDIS_SENTINELS and REDIS_MASTER_NAME, REDIS_HOST is ignored
# To enable Sentinel, set REDIS_SENTINELS like below.
REDIS_SENTINELS=redis-sentinel-stock:26379
REDIS_MASTER_NAME=stock-master

REDIS_PASSWORD=redis
REDIS_DB=0